{
  "name": "catashiro",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "main": "dist/compiled/electron/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:preload": "vite build --mode preload",
    "build:renderer": "vite build",
    "build:app": "npm run build && npm run build:preload && npm run build:renderer",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --check electron src/renderer vite.config.ts eslint.config.js",
    "format:write": "prettier --write electron src/renderer vite.config.ts eslint.config.js",
    "dev": "npm run build && npm run build:preload && concurrently -k -s first \"vite\" \"wait-on tcp:127.0.0.1:5173 && VITE_DEV_SERVER_URL=http://localhost:5173 electron dist/compiled/electron/main.js\"",
    "test": "npm run build && node --test dist/compiled/tests/unit/*.test.js",
    "poc": "npm run build && node --env-file-if-exists=.env dist/compiled/run/cli.js",
    "poc:serve": "npm run poc -- serve",
    "poc:matrix": "npm run poc -- matrix",
    "package:mac": "bash scripts/package-mac.sh",
    "release:check": "npm run typecheck && npm test && npm run poc -- check-egress && npm run poc -- check-persistence && npm run poc -- check-bypass"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@eslint/js": "^9.39.4",
    "@radix-ui/react-label": "^2.1.10",
    "@tailwindcss/vite": "^4.3.1",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.3",
    "electron": "^39.8.10",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "hash-wasm": "^4.12.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "prettier": "^3.8.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^7.3.6",
    "wait-on": "^9.0.10"
  }
}
