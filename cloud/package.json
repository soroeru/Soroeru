    "start": "node dist/cloud/src/main.js",
    "audit": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "~7.0.2"
  }
}
