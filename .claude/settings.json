{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-restricted-data.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "# ai-template:claude\n\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-repository.sh"
          }
        ]
      }
    ]
  }
}
