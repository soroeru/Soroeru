#!/usr/bin/env bash
# post-commit hook for local AI review.
#
# Triggers a background reviewer CLI on the just-created commit.
# Skips on:
#   - LOCAL_AI_REVIEW_RUNNING=1 (recursion guard)
#   - branch not matching codex/* or claude/* prefix
#   - merge / rebase / cherry-pick in progress
#   - commit message contains [skip-review]
#
# This hook is non-blocking: it returns immediately and the reviewer
# runs detached. Reviewer failures are logged to
# state/ai-reviews/last-error.log; commit success is unaffected.
#
# Note: although the plan was named after "pre-commit", we use
# post-commit so we can read the just-created commit's message via
# `git log -1` (pre-commit has no reliable access to the message).
# The non-blocking + background-launch behavior is unchanged.

set -uo pipefail

GITHOOKS_DIR=$(cd "$(dirname "$0")" && pwd)
REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0

# shellcheck source=/dev/null
. "$GITHOOKS_DIR/config"
# shellcheck source=/dev/null
. "$GITHOOKS_DIR/lib/reviewer-selection.sh"

# --- TEMPORARY: local AI review disabled ------------------------
# Codex is rate-limited, so the local AI review is paused to
# avoid failed/queued reviews on every commit. Flip the flag in
# .githooks/config back to 0 (or remove it) to restore normal
# behavior once the reviewer CLIs are available again.
# Tracking: re-enable as part of the test-matrix issue (#45).
if [ "${LOCAL_AI_REVIEW_DISABLED:-0}" = "1" ]; then
  exit 0
fi
# ----------------------------------------------------------------

# Recursion guard
if [ "${LOCAL_AI_REVIEW_RUNNING:-}" = "1" ]; then
  exit 0
fi

# Skip merge commits and rebase / cherry-pick in progress.
#
# By the time post-commit fires, MERGE_HEAD has already been removed,
# so we detect a merge commit by parent count on the just-created HEAD
# instead. rebase-merge / rebase-apply / CHERRY_PICK_HEAD persist for
# the duration of those operations, so file-based checks still work.
NUM_PARENTS=$(git show -s --format=%P HEAD 2>/dev/null | wc -w | tr -d ' ')
if [ "${NUM_PARENTS:-1}" -gt 1 ]; then
  exit 0
fi
GIT_DIR=$(git rev-parse --git-dir)
if [ -d "$GIT_DIR/rebase-merge" ] \
   || [ -d "$GIT_DIR/rebase-apply" ] \
   || [ -f "$GIT_DIR/CHERRY_PICK_HEAD" ]; then
  exit 0
fi

# Skip if commit message contains [skip-review]
HEAD_MSG=$(git log -1 --format='%B' 2>/dev/null || echo "")
case "$HEAD_MSG" in
  *'[skip-review]'*) exit 0 ;;
esac

# Detect reviewer from branch prefix. The branch's agent prefix maps
# to the same reviewer CLI.
BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
REVIEWER=$(local_ai_review_select_reviewer "$BRANCH") || exit 0

# Pin the commit that triggered this hook so the background review
# always covers the same diff, even if HEAD moves before the
# orchestrator gets to it.
HEAD_SHA=$(git rev-parse HEAD 2>/dev/null || echo "")
if [ -z "$HEAD_SHA" ]; then
  exit 0
fi

# Prepare state dir for background-launch logs
STATE_DIR="$REPO_ROOT/$LOCAL_AI_REVIEW_STATE_DIR"
mkdir -p "$STATE_DIR"
chmod 0700 "$STATE_DIR" 2>/dev/null || true
LAUNCH_LOG="$STATE_DIR/last-run.log"
LAUNCH_ERR="$STATE_DIR/last-error.log"

log_launch() {
  printf '[%s] %s\n' "$(date -u +%FT%TZ)" "$*" >> "$LAUNCH_LOG"
}

LAUNCHER="$GITHOOKS_DIR/lib/local-ai-review-launch.sh"
SHORT_SHA=$(git rev-parse --short "$HEAD_SHA" 2>/dev/null || echo unknown)

fallback_nohup() {
  [ -n "${LAUNCH_PLIST:-}" ] && rm -f "$LAUNCH_PLIST"
  env LOCAL_AI_REVIEW_LAUNCH_METHOD=nohup \
    nohup "$LAUNCHER" "$REPO_ROOT" "$GITHOOKS_DIR" "$STATE_DIR" "$REVIEWER" "$BRANCH" "$HEAD_SHA" \
    >/dev/null 2>> "$LAUNCH_ERR" </dev/null &
  LAUNCH_PID=$!
  disown "$LAUNCH_PID" 2>/dev/null || true
  log_launch "queued reviewer=$REVIEWER branch=$BRANCH commit=$HEAD_SHA method=nohup pid=$LAUNCH_PID"
}

xml_escape() {
  printf '%s' "$1" \
    | sed -e 's/&/\&amp;/g' \
          -e 's/</\&lt;/g' \
          -e 's/>/\&gt;/g' \
          -e 's/"/\&quot;/g' \
          -e "s/'/\&apos;/g"
}

plist_string() {
  printf '    <string>%s</string>\n' "$(xml_escape "$1")"
}

# On macOS, Codex non-interactive command sessions can terminate
# child process groups started with plain `nohup ... &` before the
# review completes. Bootstrap a one-shot LaunchAgent in the per-user
# launchd when available, then keep nohup as a portable fallback.
if [ "$(uname -s 2>/dev/null || echo unknown)" = "Darwin" ] \
   && command -v launchctl >/dev/null 2>&1; then
  SAFE_BRANCH=$(printf '%s' "$BRANCH" | tr -c 'A-Za-z0-9_.-' '-')
  LABEL="local-ai-review.$SAFE_BRANCH.$SHORT_SHA.$$"
  LAUNCH_DOMAIN="gui/$(id -u)"
  LAUNCH_SERVICE="$LAUNCH_DOMAIN/$LABEL"
  LAUNCH_PLIST="$STATE_DIR/.launch.$SHORT_SHA.$$.plist"
  # shellcheck disable=SC2094
  {
    printf '%s\n' '<?xml version="1.0" encoding="UTF-8"?>'
    printf '%s\n' '<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">'
    printf '%s\n' '<plist version="1.0">'
    printf '%s\n' '<dict>'
    printf '  <key>Label</key>\n'
    plist_string "$LABEL"
    printf '  <key>ProgramArguments</key>\n'
    printf '  <array>\n'
    plist_string "$LAUNCHER"
    plist_string "$REPO_ROOT"
    plist_string "$GITHOOKS_DIR"
    plist_string "$STATE_DIR"
    plist_string "$REVIEWER"
    plist_string "$BRANCH"
    plist_string "$HEAD_SHA"
    plist_string "$LAUNCH_SERVICE"
    plist_string "$LAUNCH_PLIST"
    printf '  </array>\n'
    printf '  <key>EnvironmentVariables</key>\n'
    printf '  <dict>\n'
    printf '    <key>LOCAL_AI_REVIEW_LAUNCH_METHOD</key>\n'
    plist_string "launchctl"
    printf '    <key>PATH</key>\n'
    plist_string "${PATH:-/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin}"
    printf '    <key>HOME</key>\n'
    plist_string "${HOME:-}"
    printf '    <key>SHELL</key>\n'
    plist_string "${SHELL:-/bin/bash}"
    printf '  </dict>\n'
    printf '  <key>RunAtLoad</key>\n'
    printf '  <true/>\n'
    printf '  <key>KeepAlive</key>\n'
    printf '  <false/>\n'
    printf '  <key>ProcessType</key>\n'
    plist_string "Background"
    printf '  <key>StandardOutPath</key>\n'
    plist_string "/dev/null"
    printf '  <key>StandardErrorPath</key>\n'
    plist_string "$LAUNCH_ERR"
    printf '%s\n' '</dict>'
    printf '%s\n' '</plist>'
  } > "$LAUNCH_PLIST"
  if launchctl bootstrap "$LAUNCH_DOMAIN" "$LAUNCH_PLIST" 2>> "$LAUNCH_ERR"; then
    rm -f "$LAUNCH_PLIST"
    log_launch "queued reviewer=$REVIEWER branch=$BRANCH commit=$HEAD_SHA method=launchctl label=$LABEL"
  else
    log_launch "launchctl bootstrap failed reviewer=$REVIEWER branch=$BRANCH commit=$HEAD_SHA; falling back to nohup"
    fallback_nohup
  fi
else
  fallback_nohup
fi

printf '[local-ai-review] queued %s review for %s (commit=%s)\n' \
  "$REVIEWER" "$BRANCH" "$SHORT_SHA" >&2

exit 0
